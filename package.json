{
  "name": "@wezzard/mcp-relay",
  "version": "0.14.0",
  "type": "module",
  "description": "MCP server and Claude Code plugin. Runs an agent's code on fresh, isolated VMs, several at once, each run recorded with evidence",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeZZard/mcp-relay.git"
  },
  "homepage": "https://github.com/WeZZard/mcp-relay#readme",
  "bugs": {
    "url": "https://github.com/WeZZard/mcp-relay/issues"
  },
  "keywords": [
    "pi-package",
    "mcp",
    "mcp-server",
    "claude-code",
    "computer-use",
    "browser-use",
    "vm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    ".mcp.json",
    "pi-mcp.json",
    ".claude-plugin/",
    "agents/",
    "commands/",
    "pi-prompts/"
  ],
  "bin": {
    "mcp-relay": "./dist/server.mjs"
  },
  "exports": {
    "./review-data": {
      "types": "./dist/review-data.d.ts",
      "import": "./dist/review-data.mjs"
    },
    "./package.json": "./package.json"
  },
  "pi": {
    "mcp": "./pi-mcp.json",
    "prompts": [
      "./pi-prompts/*.md"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts scripts/selected-image-x11.test.ts",
    "check": "npm run build && npm run typecheck && npm test",
    "test:e2e": "tsx --test tests/e2e/headless.test.ts",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.0.0",
    "@wezzard/relay-driver-core": "^0.2.1",
    "@wezzard/relay-driver-host-sdk": "^0.2.1",
    "@wezzard/relay-driver-remote-runtime": "^0.2.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.30",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
