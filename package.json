{
  "name": "@wezzard/mcp-relay",
  "version": "0.19.0",
  "type": "module",
  "description": "MCP server and Claude Code plugin. Runs an agent's code on fresh, isolated VMs, several at once, each run recorded with evidence",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeZZard/mcp-relay.git"
  },
  "homepage": "https://github.com/WeZZard/mcp-relay#readme",
  "bugs": {
    "url": "https://github.com/WeZZard/mcp-relay/issues"
  },
  "keywords": [
    "pi-package",
    "mcp",
    "mcp-server",
    "claude-code",
    "computer-use",
    "browser-use",
    "vm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    ".mcp.json",
    "pi-mcp.json",
    ".claude-plugin/",
    "agents/",
    "commands/",
    "pi-prompts/"
  ],
  "bin": {
    "mcp-relay": "dist/server.mjs"
  },
  "exports": {
    "./review-data": {
      "types": "./dist/review-data.d.ts",
      "import": "./dist/review-data.mjs"
    },
    "./package.json": "./package.json"
  },
  "pi": {
    "mcp": "./pi-mcp.json",
    "prompts": [
      "./pi-prompts/*.md"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs --test-concurrency=1 tests/*.test.ts scripts/selected-image-x11.test.ts",
    "check": "npm run build && npm run typecheck && npm test",
    "test:e2e": "node scripts/test.mjs tests/e2e/headless.test.ts",
    "test:broker": "node scripts/test.mjs --test-concurrency=1 tests/relay-broker.test.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "pin:machine-service": "node scripts/pin-machine-service.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@wezzard/relay-driver-core": "^0.2.1",
    "@wezzard/relay-driver-host-sdk": "^0.2.1",
    "@wezzard/relay-driver-remote-runtime": "^0.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typebox": "1.3.37",
    "typescript": "^7.0.2",
    "ws": "^8.22.1"
  },
  "engines": {
    "node": ">=22"
  }
}
