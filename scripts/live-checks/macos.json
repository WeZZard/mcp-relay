[
 {
  "tool": "relay_probe",
  "show": 300
 },
 {
  "tool": "relay_acquire",
  "args": {
   "task": "live-check-macos",
   "image": "macos26",
   "extractions": []
  },
  "stopOnError": true,
  "show": 300
 },
 {
  "tool": "relay_probe",
  "label": "guest runtimes and listed software",
  "args": {
   "guest": "live-check-macos-1",
   "scope": "guest"
  },
  "show": 1200
 },
 {
  "tool": "relay_stage",
  "args": {
   "guest": "live-check-macos-1",
   "nodePath": "/usr/local/bin/node"
  },
  "stopOnError": true,
  "show": 300
 },
 {
  "tool": "relay_command",
  "label": "cua get_screen_size",
  "args": {
   "guest": "live-check-macos-1",
   "argv": [
    "/Applications/CuaDriver.app/Contents/MacOS/cua-driver",
    "call",
    "get_screen_size",
    "--json",
    "{}"
   ]
  },
  "show": 200
 },
 {
  "tool": "relay_command",
  "label": "cua launch Calculator",
  "args": {
   "guest": "live-check-macos-1",
   "argv": [
    "/Applications/CuaDriver.app/Contents/MacOS/cua-driver",
    "call",
    "launch_app",
    "--json",
    "{\"bundle_id\": \"com.apple.calculator\"}"
   ]
  },
  "show": 200,
  "stopOnError": true
 },
 {
  "tool": "relay_script",
  "label": "inline javascript",
  "args": {
   "guest": "live-check-macos-1",
   "language": "javascript",
   "inline": true,
   "code": "console.log(process.version)"
  },
  "show": 200
 },
 {
  "tool": "relay_finish",
  "show": 1200,
  "args": {
   "guest": "live-check-macos-1"
  }
 }
]
