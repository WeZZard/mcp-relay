   "code": "/usr/local/bin/cua-driver call get_screen_size --json '{}'"
  },
  "show": 200
 },
 {
  "tool": "relay_script",
  "label": "cua list_apps",
  "args": {
   "guest": "live-check-ubuntu-1",
   "language": "shell",
   "inline": true,
   "code": "/usr/local/bin/cua-driver call list_apps --json '{}'"
  },
  "show": 200
 },
 {
  "tool": "relay_script",
  "label": "inline javascript",
  "args": {
   "guest": "live-check-ubuntu-1",
   "language": "javascript",
   "inline": true,
   "code": "console.log(process.version)"
  },
  "show": 200
 },
 {
  "tool": "relay_script",
  "label": "inline python",
  "args": {
